[run]
# The live code only. legacy/ and the streamlit_app*.py variants sit outside these directories on
# purpose (CLAUDE.md SS5/SS12), so they are not measured and need no omit entry.
source =
    core
    api
    cli
    web
    utils
omit =
    */__pycache__/*

[report]
# Measured 2026-10-27: 73% (2943 of 4012 statements) over the non-e2e suite. Floor sits two points
# below that so ordinary churn does not trip it but a real drop does; raise it when coverage rises.
# The drop from 78% (2026-10-02) is real: ~800 new statements were added (model_management,
# model_probe, neo4j_repo, hypothesis_testing, runs additions) at lower branch coverage than the
# older core. Only enforced when pytest runs with --cov (tox -e py312 / tox -e full).
fail_under = 71
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if TYPE_CHECKING:
